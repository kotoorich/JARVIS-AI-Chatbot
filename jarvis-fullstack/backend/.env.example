# Copy to .env and edit. The app runs fine with defaults if you skip this.
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./jarvis.db
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin seed (Phase 2A) ----------------------------------------------------
# Set BOTH on first run to create an admin account, then visit /admin once
# logged in. After first run you can clear INITIAL_ADMIN_PASSWORD; leaving
# INITIAL_ADMIN_EMAIL set will keep promoting that account on every restart
# (it is never demoted, but never recreated either).
# IMPORTANT: use a real-looking domain like example.com — .test/.local
# domains are rejected by the email validator.
# INITIAL_ADMIN_EMAIL=admin@example.com
# INITIAL_ADMIN_PASSWORD=ChangeMe123!

# Email + tokens (Phase 3) -------------------------------------------------
# The public URL the frontend is served from. Used to build links inside
# email bodies (verify / reset). Change for production.
FRONTEND_BASE_URL=http://localhost:5173

# EMAIL_BACKEND="console" prints emails to stdout (great for dev/demos).
# Set EMAIL_BACKEND="smtp" + the SMTP_* vars below for real delivery.
EMAIL_BACKEND=console
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your-smtp-secret
# SMTP_USE_TLS=true
# EMAIL_FROM=JARVIS <no-reply@example.com>

# Token expirations (in minutes / hours respectively)
RESET_TOKEN_TTL_MINUTES=30
VERIFY_TOKEN_TTL_HOURS=48

# Set to 1 to expose the test-only inbox endpoint /api/_test/inbox/{email}.
# Leave UNSET in production. Used only by automated E2E tests.
# TEST_MODE=1

# LLM provider (Phase 4) ---------------------------------------------------
# "offline" (default) uses the rule-based engine bundled with the app —
# JARVIS works with zero external dependencies. To use a real model, set
# LLM_PROVIDER and the corresponding API key.
#   offline   — local rule-based replies, no network
#   openai    — OpenAI Chat Completions API
#   anthropic — Anthropic Messages API
#   ollama    — local Ollama server (http://localhost:11434)
LLM_PROVIDER=offline

# Optional global settings
# LLM_TIMEOUT_SECONDS=60
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=1024   # Anthropic only

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1     # change for OpenAI-compatible hosts

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Ollama (local)
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434

# Logging (Phase 4) --------------------------------------------------------
# LOG_FORMAT=json    # "json" (default) or "text"
# LOG_LEVEL=INFO     # DEBUG | INFO | WARNING | ERROR

# Postgres (optional) ------------------------------------------------------
# Default DATABASE_URL is SQLite. To use Postgres in production:
# DATABASE_URL=postgresql+psycopg2://USER:PASS@HOST:5432/jarvis
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# Required Python package: psycopg2-binary (not in requirements.txt by default)
